{
  "roots": ["<rootDir>/src"],
  "resetMocks": true,
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.dev.json",
        "diagnostics": false
      }
    ]
  },
  "testRegex": "(test|spec)\\.[jt]sx?$",
  "collectCoverageFrom": ["src/**/*.ts"],
  "verbose": false
}
